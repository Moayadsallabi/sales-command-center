<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  RETIRED 2026-08-18. Do not load this.

  This ran the payments reconciliation on one MacBook, Mondays at 10:00, with
  --apply — it corrected the client's Notion tracker unattended. Two problems:
  a Mac that is shut down on a Monday morning skips the week silently, and an
  unattended --apply puts its best guess into a client's tracker before anyone
  has seen it.

  Replaced by `npm run check:weekly` on a Railway cron service, which reads and
  reports and never writes. See "The weekly check" in README.md.

  Kept as a record of what used to run. It executed zero times.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.perceptionismlab.scc-payments-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/momofx/Documents/Claude/sales-command-center/scripts/payments-sync-weekly.sh</string>
  </array>
  <!-- Mondays at 10:00. If the Mac was asleep at the time, launchd runs it
       on wake; if it was shut down, that week is skipped. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
</dict>
</plist>
