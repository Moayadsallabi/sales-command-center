# Copy to .env.local and fill in.

# Internal integration secret from https://www.notion.so/my-integrations (starts with ntn_ or secret_)
NOTION_API_KEY=

# The database's 32-char id, from its URL. Dashes optional.
NOTION_DATABASE_ID=

# Optional. Personal access token from calendly.com/integrations/api_webhooks.
# Adds the booking side of the funnel: what was booked, cancelled and no-showed,
# not just what got recorded. Leave blank and the dashboard runs on recordings
# alone, which is what it did before Calendly was supported.
CALENDLY_API_KEY=

# Which Calendly event types count as sales calls, comma-separated. Names as
# they read in Calendly; matching is case-insensitive and partial. Leave unset
# and EVERY booking counts, including one-to-ones and personal meetings.
# Example: Strategy Call,Discovery Call
CALENDLY_EVENT_TYPES=

# Optional. How far back to read bookings. Defaults to 90 days.
CALENDLY_LOOKBACK_DAYS=

# Optional. How long the booking list is reused before Calendly is asked again.
# Defaults to 300 seconds.
CALENDLY_CACHE_SECONDS=

# Optional, demo mode only. Set to 1 alongside DASHBOARD_DEMO_DATA=1 to preview
# the dashboard as it looks before Calendly is connected.
DEMO_WITHOUT_CALENDLY=

# Optional. Shown in the dashboard footer. Leave blank for "Sales Analytics".
NEXT_PUBLIC_BRAND_NAME=

# The currency every total on the dashboard is shown in. Defaults to USD.
# Rows priced in something else are converted using that row's FX Rate, so set
# this to the currency you actually report in — it does not convert anything on
# its own, it decides which side of the conversion the totals land on.
NEXT_PUBLIC_REPORTING_CURRENCY=

# Login password. The dashboard REFUSES TO SERVE without this, because it
# renders prospect names, deal sizes and call summaries. To publish it with no
# login anyway, leave this blank and set DASHBOARD_PUBLIC=1 below.
DASHBOARD_PASSWORD=

# Basic-auth username. Defaults to "admin" when unset.
DASHBOARD_USER=

# Set to 1 to serve the dashboard with no login at all. Only with
# DASHBOARD_PASSWORD blank, and only if you mean it.
DASHBOARD_PUBLIC=

# Set to 1 to render invented sample calls instead of reading Notion, so you
# can see the dashboard before the first real call lands. Never in a real
# deployment.
DASHBOARD_DEMO_DATA=

# Optional. Payment processor key, for `npm run check:payments`, which
# reconciles the tracker against money that actually arrived — the only way a
# deal that closed three days after the call gets noticed. Needs the
# payment:basic:read permission from Whop's developer settings page.
WHOP_API_KEY=
